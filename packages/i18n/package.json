{
  "name": "@ho-dev/i18n",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Internationalization utilities.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "react",
    "i18n",
    "internationalization"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/i18n"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ho-dev/types": "workspace:*"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && node ../../scripts/fix-esm-extensions.mjs",
    "test": "cd ../.. && vitest run packages/i18n/src"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "devDependencies": {}
}
