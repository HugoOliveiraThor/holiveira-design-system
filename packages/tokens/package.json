{
  "name": "@ho-dev/tokens",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Raw design token definitions.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "react",
    "design-tokens",
    "tailwindcss"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": {
      "import": "./dist/tokens.css",
      "default": "./dist/tokens.css"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {},
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && cp src/tokens.css dist/ && node ../../scripts/fix-esm-extensions.mjs",
    "test": "cd ../.. && vitest run packages/tokens/src"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js",
  "devDependencies": {}
}
