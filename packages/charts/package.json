{
  "name": "@ho-dev/charts",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Chart and visualization components.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "react",
    "charts",
    "visualization",
    "apexcharts"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/charts"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ho-dev/hooks": "workspace:*",
    "@ho-dev/theme": "workspace:*",
    "@ho-dev/types": "workspace:*",
    "@ho-dev/utils": "workspace:*"
  },
  "peerDependencies": {
    "apexcharts": "^4.0.0",
    "next": "^16.4.1",
    "react": "^19.0.0",
    "react-apexcharts": "^1.0.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@ho-dev/testing": "workspace:*",
    "@storybook/test": "^8.6.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && tailwindcss -i src/chart-styles.build.css -o dist/chart-styles.css && node ../../scripts/fix-esm-extensions.mjs",
    "test": "cd ../.. && vitest run packages/charts/src"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart-styles.css": {
      "import": "./dist/chart-styles.css",
      "default": "./dist/chart-styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js"
}
