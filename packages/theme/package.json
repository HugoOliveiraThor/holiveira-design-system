{
  "name": "@ho-dev/theme",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Design tokens and theme system.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "react",
    "theme",
    "design-tokens",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && tailwindcss -i src/theme.css -o dist/theme.css && node ../../scripts/fix-esm-extensions.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@ho-dev/tokens": "workspace:*",
    "@ho-dev/types": "workspace:*"
  },
  "devDependencies": {}
}
