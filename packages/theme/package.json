{
  "name": "@holiveira/theme",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Design tokens and theme system.",
  "keywords": [
    "holiveira",
    "design-system",
    "react",
    "theme",
    "design-tokens",
    "dark-mode"
  ],
  "license": "MIT",
  "author": "Holiveira",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/theme"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": {
      "import": "./dist/theme.css",
      "default": "./dist/theme.css"
    }
  },
  "peerDependencies": {
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@holiveira/types": "workspace:*",
    "@holiveira/tokens": "workspace:*",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp src/theme.css dist/"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
