{
  "name": "@ho-dev/forms",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "Form components with validation integration.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "react",
    "forms",
    "validation",
    "react-hook-form"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@ho-dev/hooks": "workspace:*",
    "@ho-dev/primitives": "workspace:*",
    "@ho-dev/types": "workspace:*",
    "@ho-dev/utils": "workspace:*"
  },
  "peerDependencies": {
    "flatpickr": "^4.0.0",
    "react": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@ho-dev/testing": "workspace:*",
    "@ho-dev/theme": "workspace:*",
    "@storybook/test": "^8.6.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc && tailwindcss -i src/widgets/date-picker-styles.build.css -o dist/date-picker-styles.css && node ../../scripts/fix-esm-extensions.mjs",
    "test": "cd ../.. && vitest run packages/forms/src"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./date-picker-styles.css": {
      "import": "./dist/date-picker-styles.css",
      "default": "./dist/date-picker-styles.css"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
