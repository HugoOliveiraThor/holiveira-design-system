{
  "name": "@holiveira/forms",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Form components with validation integration.",
  "keywords": [
    "holiveira",
    "design-system",
    "react",
    "forms",
    "validation",
    "react-hook-form"
  ],
  "license": "MIT",
  "author": "Holiveira",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/forms"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@holiveira/hooks": "workspace:*",
    "@holiveira/primitives": "workspace:*",
    "@holiveira/utils": "workspace:*"
  },
  "peerDependencies": {
    "@holiveira/types": "workspace:*",
    "flatpickr": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "typescript": "^5.0.0",
    "zod": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@storybook/test": "^8.6.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && cp src/widgets/date-picker-styles.css dist/"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./date-picker-styles.css": {
      "import": "./dist/date-picker-styles.css",
      "default": "./dist/date-picker-styles.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
