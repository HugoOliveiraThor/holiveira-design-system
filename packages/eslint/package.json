{
  "name": "@ho-dev/eslint",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "ESLint configuration presets for HO Design System projects.",
  "keywords": [
    "holiveira",
    "ho-dev",
    "design-system",
    "eslint",
    "typescript",
    "react"
  ],
  "license": "MIT",
  "author": "HO Design System",
  "homepage": "https://github.com/HugoOliveiraThor/holiveira-design-system#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system.git",
    "directory": "packages/eslint"
  },
  "bugs": {
    "url": "https://github.com/HugoOliveiraThor/holiveira-design-system/issues"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.2.0"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "module": "./dist/index.js"
}
