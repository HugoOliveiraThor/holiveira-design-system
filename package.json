{
  "name": "ho-design-system",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/ apps/",
    "lint:fix": "eslint packages/ apps/ --fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:visual": "pnpm run build:storybook && pnpm --filter storybook run test:visual",
    "screenshots": "pnpm run build:storybook && node apps/storybook/scripts/capture-screenshots.mjs",
    "check:size": "pnpm exec tsx scripts/check-size.ts",
    "check:exports": "pnpm exec tsx scripts/check-exports.ts",
    "check:publish": "pnpm exec tsx scripts/check-publish.ts",
    "check:install": "pnpm --filter consumer-test run validate:packed",
    "check:license": "pnpm exec tsx scripts/check-license.ts",
    "check:deps": "syncpack lint --dependency-types prod,dev",
    "check:deps:peer": "pnpm peers check 2>&1 || true",
    "check:unused": "knip",
    "dev": "turbo run dev",
    "dev:storybook": "turbo run dev --filter=storybook",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "auth:generate": "npx @better-auth/cli generate --config ./packages/auth/src/auth.ts --output ./packages/db/prisma/schema.prisma",
    "changeset": "changeset",
    "version": "changeset version",
    "release:publish": "turbo run build --filter='./packages/*' && changeset publish",
    "prepare": "husky",
    "all-checks": "pnpm run format:check && turbo run lint && pnpm run db:generate && turbo run typecheck && turbo run build && turbo run build:storybook && pnpm run test:visual && pnpm run test:coverage && pnpm run check:size && pnpm run check:publish && pnpm run check:install && pnpm run check:license && pnpm run check:exports && pnpm run check:deps"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@ho-dev/eslint": "workspace:*",
    "@size-limit/preset-small-lib": "^13.0.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "agadoo": "^3.0.0",
    "axe-core": "^4.12.1",
    "eslint": "^10",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "knip": "^6.31.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "prisma": "^7.8.0",
    "publint": "^0.3.22",
    "size-limit": "^13.0.1",
    "syncpack": "^15.3.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4",
    "turbo": "^2.10.5",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "vitest-axe": "^0.1.0"
  }
}
