{
  "name": "holiveira",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/ apps/",
    "lint:fix": "eslint packages/ apps/ --fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:storybook": "turbo run build:storybook",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "check:exports": "pnpm exec tsx scripts/check-exports.ts",
    "check:deps": "syncpack lint --dependency-types prod,dev",
    "check:deps:peer": "pnpm peers check 2>&1 || true",
    "dev": "turbo run dev",
    "dev:storybook": "turbo run dev --filter=storybook",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "auth:generate": "npx @better-auth/cli generate --config ./packages/auth/src/auth.ts --output ./packages/db/prisma/schema.prisma",
    "prepare": "husky",
    "all-checks": "pnpm run format:check && turbo run lint && turbo run typecheck && turbo run build && turbo run build:storybook && pnpm run test && pnpm run check:exports && pnpm run check:deps"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@tailwindcss/postcss": "^4.2.4",
    "@holiveira/eslint": "workspace:*",
    "@types/node": "^22",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "prisma": "^7.8.0",
    "syncpack": "^15.3.2",
    "tailwindcss": "^4.2.4",
    "tsx": "^4",
    "turbo": "^2.10.5",
    "typescript": "^5"
  }
}
