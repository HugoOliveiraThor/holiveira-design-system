{
  "name": "holiveira",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint packages/ apps/",
    "lint:fix": "eslint packages/ apps/ --fix",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "build:storybook": "turbo run storybook",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "check:deps": "syncpack lint --dependency-types prod,dev",
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:studio": "prisma studio --schema=packages/db/prisma/schema.prisma",
    "auth:generate": "npx @better-auth/cli generate --config ./packages/auth/src/auth.ts --output ./packages/db/prisma/schema.prisma",
    "prepare": "husky",
    "all-checks": "pnpm run check:deps && pnpm run format:check && pnpm run lint && pnpm run build && pnpm run typecheck && pnpm run build:storybook && pnpm run test"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22",
    "@tailwindcss/postcss": "^4.2.4",
    "tailwindcss": "^4.2.4",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "eslint": "^9",
    "eslint-config-next": "15.1.6",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.3",
    "prisma": "^7.8.0",
    "syncpack": "^15.3.2",
    "turbo": "^2.10.5",
    "typescript": "^5"
  }
}
