{
  "name": "@ho-dev/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "check:export": "tsx scripts/check-export.ts",
    "typecheck": "tsc --noEmit",
    "test:export": "next build && tsx scripts/check-export.ts",
    "generate:metadata": "pnpm exec tsx scripts/generate-docs-metadata.ts",
    "check:metadata": "pnpm exec tsx scripts/generate-docs-metadata.ts --check",
    "test:e2e": "next build && playwright test",
    "test:e2e:built": "node scripts/require-export.mjs && playwright test"
  },
  "dependencies": {
    "@ho-dev/charts": "workspace:*",
    "@ho-dev/forms": "workspace:*",
    "@ho-dev/hooks": "workspace:*",
    "@ho-dev/icons": "workspace:*",
    "@ho-dev/layouts": "workspace:*",
    "@ho-dev/primitives": "workspace:*",
    "@ho-dev/providers": "workspace:*",
    "@ho-dev/theme": "workspace:*",
    "@ho-dev/tokens": "workspace:*",
    "@ho-dev/ui": "workspace:*",
    "@ho-dev/utils": "workspace:*"
  },
  "peerDependencies": {
    "apexcharts": "^4.5.0",
    "flatpickr": "^4.6.13",
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-apexcharts": "^1.7.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.82.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1"
  }
}
