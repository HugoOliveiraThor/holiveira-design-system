{
  "name": "@ho-dev/docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test:export": "next build && tsx scripts/check-export.ts",
    "generate:metadata": "pnpm exec tsx scripts/generate-docs-metadata.ts",
    "check:metadata": "pnpm exec tsx scripts/generate-docs-metadata.ts --check",
    "test:e2e": "next build && playwright test"
  },
  "dependencies": {
    "@ho-dev/theme": "workspace:*",
    "@ho-dev/utils": "workspace:*"
  },
  "peerDependencies": {
    "next": "^16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.62.1"
  }
}
